---
import type { GalleryItem } from "../data/gallery";

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <button
        class:list={[
          "gallery-item group relative block w-full cursor-pointer overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 transition-colors hover:border-zinc-300",
          item.wide && "sm:col-span-2",
        ]}
        data-src={item.src}
        data-title={item.title}
      >
        <img
          src={item.src}
          alt={item.alt}
          class="w-full transition-transform group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3">
          <p class="text-sm font-medium text-white">{item.title}</p>
        </div>
      </button>
    ))
  }
</div>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
>
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 text-white hover:text-zinc-300 cursor-pointer"
    aria-label="Close lightbox"
  >
    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg" />
  <p id="lightbox-title" class="absolute bottom-6 text-center text-white text-lg font-medium"></p>
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.getElementById("lightbox");
    if (!lightbox) return;

    const lightboxImg = document.getElementById("lightbox-img");
    const lightboxTitle = document.getElementById("lightbox-title");
    const items = Array.from(document.querySelectorAll(".gallery-item"));
    let currentIndex = 0;

    function showItem(index) {
      currentIndex = index;
      lightboxImg.src = items[index].dataset.src;
      lightboxImg.alt = items[index].dataset.title;
      lightboxTitle.textContent = items[index].dataset.title;
    }

    function openLightbox(index) {
      showItem(index);
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
    }

    items.forEach((item, i) => {
      item.addEventListener("click", () => openLightbox(i));
    });

    document.getElementById("lightbox-close").addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        showItem((currentIndex - 1 + items.length) % items.length);
      }
      if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        showItem((currentIndex + 1) % items.length);
      }
    });
  });
</script>
