---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
---

<BaseLayout title="Jack Hsu">
  <!-- Hero -->
  <section class="flex flex-col items-center text-center">
    <Image
      src={avatar}
      alt="Jack Hsu"
      width={128}
      height={128}
      class="rounded-full"
    />
    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
      Jack Hsu
    </h1>
    <p class="mt-3 max-w-md text-lg text-zinc-600 dark:text-zinc-400">
      Software engineer. Building things for the web.
    </p>
    <div class="mt-5 flex gap-4">
      <a
        href="https://github.com/jackhsu978"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-zinc-600 dark:text-zinc-400 underline underline-offset-2 hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/jackhsu978/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium text-zinc-600 dark:text-zinc-400 underline underline-offset-2 hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        LinkedIn
      </a>
    </div>
  </section>

  <!-- Section Cards -->
  <section class="mt-16 grid gap-6 sm:grid-cols-3">
    <a
      href="/projects"
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 p-6 transition-colors hover:border-zinc-300 dark:hover:border-zinc-600"
    >
      <h2 class="text-lg font-semibold group-hover:underline">🚀 Projects</h2>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
        Things I've built and am working on.
      </p>
    </a>
    <a
      href="/gallery"
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 p-6 transition-colors hover:border-zinc-300 dark:hover:border-zinc-600"
    >
      <h2 class="text-lg font-semibold group-hover:underline">🎨 Gallery</h2>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
        Drawings and visual work.
      </p>
    </a>
    <a
      href="/resume"
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 p-6 transition-colors hover:border-zinc-300 dark:hover:border-zinc-600"
    >
      <h2 class="text-lg font-semibold group-hover:underline">📄 Resume</h2>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
        My experience and skills.
      </p>
    </a>
  </section>
</BaseLayout>
