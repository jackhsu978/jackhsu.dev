---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, contributions } from "../data/projects";
---

<BaseLayout title="Projects - Jack Hsu" description="Projects by Jack Hsu">
  <h1 class="text-3xl font-bold tracking-tight">🚀 Projects</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-400">
    Things I've built and am working on.
  </p>
  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          url={project.url}
          repo={project.repo}
        />
      ))
    }
  </div>

  {
    contributions.length > 0 && (
      <>
        <h2 class="mt-16 text-2xl font-bold tracking-tight">🤝 Contributions</h2>
        <p class="mt-2 text-zinc-600 dark:text-zinc-400">
          Open source projects I've contributed to.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {contributions.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              tags={project.tags}
              url={project.url}
              repo={project.repo}
            />
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
